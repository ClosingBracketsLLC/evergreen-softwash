---
import Base from '@layouts/Base.astro';
import SectionHead from '@components/SectionHead.astro';
import ContactForm from '@components/ContactForm.astro';
import FaqList from '@components/FaqList.astro';
import Icon from '@components/Icon.astro';
import { site } from '@config';
import { generalFaqs } from '@data/faqs';
---

<Base
  title="Request a Quote"
  description="Request a fixed written quote for soft washing, pressure washing, or detailing anywhere in greater Puget Sound. We reply within one business day."
>
  <section class="contact-hero tone-dark">
    <div class="container">
      <SectionHead
        as="h1"
        eyebrow="Contact"
        title="Tell us what deserves better"
        lede="A few details are all we need to prepare an accurate, fixed quote — most within one business day."
      />
    </div>
  </section>

  <section class="section tone-pale">
    <div class="container contact-grid">
      <ContactForm />

      <aside class="contact-aside">
        <div class="contact-block" data-reveal>
          <Icon name="phone" size={22} />
          <h3>Prefer to talk?</h3>
          <p><a class="contact-phone" href={site.phoneHref}>{site.phone}</a></p>
          <p class="contact-meta">{site.hours}</p>
        </div>
        <div class="contact-block" data-reveal>
          <Icon name="calendar" size={22} />
          <h3>What happens next</h3>
          <ol class="contact-steps">
            <li>We review your details and aerial imagery of the property.</li>
            <li>You receive a fixed written quote — no ranges, no surprises.</li>
            <li>We schedule around your calendar, not ours.</li>
          </ol>
        </div>
        <div class="contact-block" data-reveal>
          <Icon name="shield" size={22} />
          <h3>Certificates on request</h3>
          <p class="contact-meta">
            HOAs, FBOs, and marinas: certificates of insurance and product documentation are
            available before work begins — email
            <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Common questions" title="Answers before you ask" />
      <FaqList faqs={generalFaqs} />
    </div>
  </section>
</Base>

<style>
  .contact-hero {
    padding-block: 11rem 4rem;
  }

  .contact-hero :global(.section-head) {
    margin-block-end: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .contact-aside {
    display: grid;
    gap: 1.25rem;
  }

  .contact-block {
    padding: 1.75rem;
    background: var(--white);
    border: 1px solid var(--seaglass-deep);
    border-radius: var(--radius-lg);
  }

  .contact-block svg {
    color: var(--river);
    margin-block-end: 0.8rem;
  }

  .contact-block h3 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    letter-spacing: 0;
    margin-block-end: 0.5rem;
  }

  .contact-block p {
    font-size: var(--text-sm);
  }

  .contact-phone {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--evergreen);
  }

  .contact-meta {
    color: var(--ink-soft);
  }

  .contact-steps {
    margin: 0;
    padding-inline-start: 1.2rem;
    display: grid;
    gap: 0.6rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  @media (max-width: 60rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
