---
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import Button from '@components/Button.astro';
import SectionHead from '@components/SectionHead.astro';
import ServiceCard from '@components/ServiceCard.astro';
import Testimonials from '@components/Testimonials.astro';
import FaqList from '@components/FaqList.astro';
import CtaBand from '@components/CtaBand.astro';
import Waterline from '@components/Waterline.astro';
import { services } from '@data/services';
import { generalFaqs } from '@data/faqs';
import { images } from '@data/images';
---

<Base
  title="Luxury Soft Washing, Pressure Washing & Detailing in Puget Sound"
  description="Estate-grade exterior care across greater Puget Sound: soft washing, pressure washing, and concierge detailing for fine homes, vehicles, aircraft, and watercraft."
>
  <!-- ——— Hero ——— -->
  <section class="hero">
    <Image
      class="hero-bg"
      src={images.estateDusk}
      alt="Immaculate modern estate glowing at dusk, freshly washed stone driveway reflecting the interior light"
      widths={[768, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality="mid"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="eyebrow hero-eyebrow">Soft washing · Pressure washing · Concierge detailing</p>
      <h1>
        The estate standard<br />
        <span class="hero-accent">of clean</span>
      </h1>
      <Waterline />
      <p class="hero-lede">
        From rooflines to hull lines, Evergreen cares for the surfaces other companies
        won't touch, and finishes them to a standard you can see from across the water.
      </p>
      <div class="hero-actions">
        <Button href="/contact/" variant="ice">Request a quote</Button>
        <Button href="/services/" variant="ghost">Explore services</Button>
      </div>
      <ul class="hero-marks" aria-label="Trust markers">
        <li>Licensed &amp; insured</li>
        <li>2-year algae-free promise</li>
        <li>Serving greater Puget Sound</li>
      </ul>
    </div>
  </section>

  <!-- ——— Positioning ——— -->
  <section class="section positioning">
    <div class="container">
      <div class="positioning-grid">
        <div data-reveal>
          <p class="eyebrow">Why we exist</p>
        </div>
        <div>
          <p class="positioning-statement" data-reveal>
            A pressure washer is a tool. <em>Restraint</em> is a discipline. We built Evergreen
            around the second one: gentle chemistry where surfaces are delicate, calibrated
            power where they aren't, and a finishing eye for properties where good enough isn't.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ——— Services ——— -->
  <section class="section tone-pale" id="services">
    <div class="container-wide">
      <SectionHead
        eyebrow="What we care for"
        title="Five disciplines. One standard."
        lede="Every service is performed by our own uniformed crews, never subcontractors, and closed out with a documented walkthrough."
      />
      <div class="services-grid">
        {services.map((service, i) => <ServiceCard service={service} loading={i < 3 ? 'eager' : 'lazy'} />)}
        <a class="program-card" href="/contact/" data-reveal>
          <p class="eyebrow">For households that book it all</p>
          <h3>The Evergreen Estate Program</h3>
          <p>
            Home, hardscape, vehicles, and vessels on one seasonal calendar — priority
            scheduling, one point of contact, and member pricing across every service.
          </p>
          <span class="program-more">Enquire about membership</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ——— Proof ——— -->
  <section class="section proof tone-dark">
    <div class="container proof-grid">
      <figure class="proof-media" data-reveal>
        <Image
          src={images.roof}
          alt="Half-cleaned slate roof showing the dramatic line between algae-streaked and restored shingles"
          widths={[640, 960, 1400]}
          sizes="(max-width: 60rem) 92vw, 48vw"
          loading="lazy"
          quality="mid"
        />
        <figcaption>A roof mid-treatment. The line speaks for itself.</figcaption>
      </figure>
      <div class="proof-copy">
        <SectionHead
          eyebrow="The difference is chemistry"
          title="We don't blast growth away. We end it."
          lede="High pressure shears moss and algae off at the surface, stripping granules and gouging cedar along the way. Our soft wash dissolves growth at the root, so surfaces stay clean for seasons and age the way their architects intended."
        />
        <ul class="proof-points" data-reveal>
          <li>
            <strong>4–6× longer lasting</strong> than pressure washing alone on roofs and siding
          </li>
          <li>
            <strong>Manufacturer-approved</strong> methods for composite, cedar, tile, and metal
          </li>
          <li>
            <strong>Landscape-safe</strong> — plantings pre-soaked, covered, and rinsed throughout
          </li>
        </ul>
        <Button href="/services/soft-washing/" variant="ice">About soft washing</Button>
      </div>
    </div>
  </section>

  <!-- ——— Estate program ——— -->
  <section class="section estate">
    <div class="container estate-grid">
      <div class="estate-copy">
        <SectionHead
          eyebrow="The Evergreen Estate Program"
          title="One calendar. Every surface."
          lede="Members hand us the whole checklist: the house wash in spring, the drive before the garden party, the boat ahead of opening day, the cars every month. We keep the schedule; you keep the weekends."
        />
        <ul class="estate-points" data-reveal>
          <li>Seasonal care plan drawn up after a full property walkthrough</li>
          <li>Priority scheduling — including before events, listings, and surveys</li>
          <li>One point of contact for home, vehicles, aircraft, and watercraft</li>
          <li>Member pricing, typically 15–20% below à-la-carte rates</li>
        </ul>
        <Button href="/contact/">Enquire about membership</Button>
      </div>
      <figure class="estate-media" data-reveal>
        <Image
          src={images.manor}
          alt="Technician in a deep green uniform rinsing a limestone balustrade at a lakeside stone manor"
          widths={[640, 960, 1400]}
          sizes="(max-width: 60rem) 92vw, 48vw"
          loading="lazy"
          quality="mid"
        />
      </figure>
    </div>
  </section>

  <Testimonials />

  <!-- ——— FAQ ——— -->
  <section class="section tone-pale">
    <div class="container">
      <SectionHead
        eyebrow="Before you ask"
        title="Sensible questions, straight answers"
      />
      <FaqList faqs={generalFaqs} withSchema />
    </div>
  </section>

  <CtaBand image="waterTexture" />
</Base>

<style>
  /* ——— Hero ——— */
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: 8rem 5rem;
    color: var(--seaglass);
    overflow: hidden;
    background: var(--pine-950);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(4 23 16 / 0.92), transparent 45%),
      linear-gradient(100deg, rgb(4 23 16 / 0.82) 10%, rgb(4 23 16 / 0.28) 55%, transparent);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: none;
  }

  .hero-eyebrow {
    color: var(--ice);
    margin-block-end: 1.4rem;
  }

  .hero h1 {
    font-size: var(--step-hero);
    color: var(--white);
    max-width: 12ch;
  }

  .hero-accent {
    color: var(--ice);
  }

  .hero-lede {
    max-width: 52ch;
    font-size: var(--text-xl);
    line-height: 1.55;
    color: color-mix(in srgb, var(--seaglass) 88%, transparent);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-block-start: 2.4rem;
  }

  .hero-marks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.25rem;
    list-style: none;
    margin: 3.2rem 0 0;
    padding: 0;
  }

  .hero-marks li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--seaglass) 75%, transparent);
  }

  .hero-marks li::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--ice);
  }

  /* ——— Positioning ——— */
  .positioning-grid {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 2rem;
  }

  .positioning-statement {
    font-size: clamp(1.35rem, 1.1rem + 1.2vw, 1.9rem);
    line-height: 1.5;
    max-width: 34em;
    text-wrap: pretty;
  }

  .positioning-statement em {
    color: var(--river);
    font-style: italic;
  }

  /* ——— Services ——— */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .program-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    justify-content: center;
    padding: 2.4rem 2rem;
    background: var(--evergreen);
    border-radius: var(--radius-lg);
    color: var(--seaglass);
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition: transform 0.35s var(--ease-out), background-color 0.35s var(--ease-out);
  }

  .program-card:hover {
    transform: translateY(-0.35rem);
    background: var(--pine-800);
  }

  .program-card .eyebrow {
    color: var(--ice);
    font-size: 0.72rem;
  }

  .program-card h3 {
    color: var(--white);
  }

  .program-card p:not(.eyebrow) {
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--seaglass) 82%, transparent);
  }

  .program-more {
    margin-block-start: 0.4rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ice);
  }

  /* ——— Proof ——— */
  .proof-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .proof-media img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  .proof-media figcaption {
    margin-block-start: 0.9rem;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--seaglass) 60%, transparent);
  }

  .proof-copy :global(.section-head) {
    margin-block-end: 1.6rem;
  }

  .proof-points {
    list-style: none;
    margin: 0 0 2.2rem;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .proof-points li {
    position: relative;
    padding-inline-start: 1.4rem;
    color: color-mix(in srgb, var(--seaglass) 82%, transparent);
  }

  .proof-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--ice);
  }

  .proof-points strong {
    color: var(--white);
  }

  /* ——— Estate ——— */
  .estate-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .estate-media img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .estate-points {
    list-style: none;
    margin: 0 0 2.2rem;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .estate-points li {
    display: flex;
    gap: 0.75rem;
    color: var(--ink-soft);
  }

  .estate-points li::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-block-start: 0.5em;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--river);
  }

  /* ——— Responsive ——— */
  @media (max-width: 64rem) {
    .services-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 60rem) {
    .positioning-grid,
    .proof-grid,
    .estate-grid {
      grid-template-columns: 1fr;
    }

    .estate-media {
      order: -1;
    }
  }

  @media (max-width: 44rem) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
