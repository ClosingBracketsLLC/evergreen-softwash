---
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import SectionHead from '@components/SectionHead.astro';
import PriceCard from '@components/PriceCard.astro';
import FaqList from '@components/FaqList.astro';
import CtaBand from '@components/CtaBand.astro';
import Waterline from '@components/Waterline.astro';
import ServiceCard from '@components/ServiceCard.astro';
import { services } from '@data/services';
import { images } from '@data/images';
import { site } from '@config';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const photo = images[service.image as keyof typeof images];
const related = services.filter((s) => s.slug !== service.slug).slice(0, 3);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${service.name} — ${site.name}`,
  serviceType: service.name,
  description: service.short,
  provider: { '@id': `${site.domain}/#business` },
  areaServed: site.serviceAreas.map((name) => ({ '@type': 'City', name })),
  offers: service.pricing.map((tier) => ({
    '@type': 'Offer',
    name: tier.name,
    description: tier.summary,
    priceSpecification: {
      '@type': 'PriceSpecification',
      price: tier.price.replace(/[^0-9.]/g, ''),
      priceCurrency: 'USD',
    },
  })),
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.domain },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.domain}/services/` },
    { '@type': 'ListItem', position: 3, name: service.name, item: `${site.domain}/services/${service.slug}/` },
  ],
};
---

<Base
  title={service.seoTitle}
  description={service.seoDescription}
  ogImage={service.image as keyof typeof images}
  schema={[serviceSchema, breadcrumbs]}
>
  <!-- ——— Service hero ——— -->
  <section class="svc-hero">
    <Image
      class="svc-hero-bg"
      src={photo}
      alt={service.imageAlt}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality="mid"
    />
    <div class="svc-hero-scrim" aria-hidden="true"></div>
    <div class="container svc-hero-inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/services/">Services</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{service.name}</span>
      </nav>
      <p class="eyebrow svc-eyebrow">{service.eyebrow}</p>
      <h1>{service.name}</h1>
      <Waterline />
    </div>
  </section>

  <!-- ——— Intro + features ——— -->
  <section class="section">
    <div class="container svc-intro-grid">
      <div class="svc-intro" data-reveal>
        {service.intro.map((para) => <p>{para}</p>)}
      </div>
      <aside class="svc-features">
        {
          service.features.map((f) => (
            <div class="svc-feature" data-reveal>
              <h3>{f.title}</h3>
              <p>{f.detail}</p>
            </div>
          ))
        }
      </aside>
    </div>
  </section>

  <!-- ——— Process ——— -->
  <section class="section tone-dark">
    <div class="container">
      <SectionHead
        eyebrow="How it unfolds"
        title="A process you can watch work"
      />
      <ol class="process-grid">
        {
          service.process.map((step, i) => (
            <li class="process-step" data-reveal>
              <span class="process-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ——— Pricing ——— -->
  <section class="section tone-pale" id="pricing">
    <div class="container">
      <SectionHead
        eyebrow="Investment"
        title="Starting prices"
        lede={service.pricingNote}
      />
      <div class="pricing-grid">
        {service.pricing.map((tier) => <PriceCard tier={tier} />)}
      </div>
    </div>
  </section>

  <!-- ——— FAQ ——— -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Good to know" title={`${service.name} questions`} />
      <FaqList faqs={service.faqs} withSchema />
    </div>
  </section>

  <!-- ——— Related ——— -->
  <section class="section tone-pale">
    <div class="container-wide">
      <SectionHead eyebrow="While we're there" title="Often booked together" />
      <div class="related-grid">
        {related.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <CtaBand
    title={`Ready for ${service.name.toLowerCase()}?`}
    lede="Send the details and we'll reply with a fixed written quote within one business day."
  />
</Base>

<style>
  .svc-hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 62svh;
    padding-block: 10rem 3.5rem;
    color: var(--seaglass);
    overflow: hidden;
    background: var(--pine-950);
  }

  .svc-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .svc-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(4 23 16 / 0.94), rgb(4 23 16 / 0.35) 55%, rgb(4 23 16 / 0.25));
  }

  .svc-hero-inner {
    position: relative;
    z-index: 1;
  }

  .crumbs {
    display: flex;
    gap: 0.6rem;
    margin-block-end: 1.5rem;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--seaglass) 70%, transparent);
  }

  .crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ice);
  }

  .crumbs [aria-current] {
    color: var(--ice);
  }

  .svc-eyebrow {
    color: var(--ice);
    margin-block-end: 0.8rem;
  }

  .svc-hero h1 {
    color: var(--white);
  }

  /* ——— Intro ——— */
  .svc-intro-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  .svc-intro p {
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .svc-intro p + p {
    margin-block-start: 1.4rem;
  }

  .svc-features {
    display: grid;
    gap: 1.25rem;
  }

  .svc-feature {
    padding: 1.6rem;
    background: var(--seaglass);
    border-radius: var(--radius-lg);
    border-inline-start: 3px solid var(--river);
  }

  .svc-feature h3 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    letter-spacing: 0;
    margin-block-end: 0.4rem;
    color: var(--evergreen);
  }

  .svc-feature p {
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  /* ——— Process ——— */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }

  .process-step {
    padding: 1.75rem 1.5rem;
    background: var(--pine-900);
    border: 1px solid rgb(196 249 255 / 0.12);
    border-radius: var(--radius-lg);
  }

  .process-num {
    display: block;
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--ice);
    margin-block-end: 0.9rem;
  }

  .process-step h3 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    letter-spacing: 0;
    color: var(--white);
    margin-block-end: 0.45rem;
  }

  .process-step p {
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--seaglass) 75%, transparent);
  }

  /* ——— Pricing / related ——— */
  .pricing-grid,
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 64rem) {
    .process-grid {
      grid-template-columns: 1fr 1fr;
    }

    .pricing-grid,
    .related-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 60rem) {
    .svc-intro-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 44rem) {
    .process-grid,
    .pricing-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
