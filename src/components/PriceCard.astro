---
import type { PricingTier } from '@data/services';

interface Props {
  tier: PricingTier;
}
const { tier } = Astro.props;
---

<article class:list={['price-card', { 'is-featured': tier.featured }]} data-reveal>
  {tier.featured && <p class="price-flag">Most requested</p>}
  <h3 class="price-name">{tier.name}</h3>
  <p class="price-amount">
    {tier.price}
    {tier.unit && <span class="price-unit">{tier.unit}</span>}
  </p>
  <p class="price-summary">{tier.summary}</p>
  <ul class="price-includes">
    {tier.includes.map((item) => <li>{item}</li>)}
  </ul>
  <a class="price-cta" href="/contact/">Request this service</a>
</article>

<style>
  .price-card {
    display: flex;
    flex-direction: column;
    padding: 2rem 1.8rem;
    background: var(--white);
    border: 1px solid var(--seaglass-deep);
    border-radius: var(--radius-lg);
    position: relative;
  }

  .price-card.is-featured {
    background: var(--pine-950);
    color: var(--seaglass);
    border-color: var(--pine-950);
    box-shadow: var(--shadow-card);
  }

  .price-flag {
    position: absolute;
    top: -0.8rem;
    left: 1.8rem;
    padding: 0.25rem 0.8rem;
    background: var(--ice);
    color: var(--evergreen);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 999px;
  }

  .price-name {
    font-size: 1.5rem;
    letter-spacing: 0.05em;
  }

  .price-card.is-featured .price-name {
    color: var(--white);
  }

  .price-amount {
    margin-block: 0.75rem 0.5rem;
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--evergreen);
  }

  .price-card.is-featured .price-amount {
    color: var(--ice);
  }

  .price-unit {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--ink-soft);
  }

  .price-card.is-featured .price-unit {
    color: color-mix(in srgb, var(--seaglass) 70%, transparent);
  }

  .price-summary {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    min-height: 2.6em;
  }

  .price-card.is-featured .price-summary {
    color: color-mix(in srgb, var(--seaglass) 78%, transparent);
  }

  .price-includes {
    list-style: none;
    margin: 1.4rem 0 1.8rem;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    flex: 1;
  }

  .price-includes li {
    display: flex;
    gap: 0.65rem;
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .price-includes li::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-block-start: 0.42em;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--river);
  }

  .price-card.is-featured .price-includes li::before {
    background: var(--ice);
  }

  .price-cta {
    display: block;
    text-align: center;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--evergreen);
    color: var(--evergreen);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .price-cta:hover {
    background: var(--evergreen);
    color: var(--white);
  }

  .price-card.is-featured .price-cta {
    border-color: var(--ice);
    color: var(--ice);
  }

  .price-card.is-featured .price-cta:hover {
    background: var(--ice);
    color: var(--evergreen);
  }
</style>
