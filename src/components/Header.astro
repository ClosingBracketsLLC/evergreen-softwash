---
import { site, nav } from '@config';
import logoWordmarkWhite from '../assets/brand/EGSW_logo_wordmark_white.svg';
import Icon from './Icon.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const clean = href.replace(/\/$/, '');
  return clean === '/' ? currentPath === '/' : currentPath.startsWith(clean);
};
---

<header class="site-header">
  <div class="container-wide header-inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      <img src={logoWordmarkWhite.src} alt="" width="188" height="56" loading="eager" />
    </a>

    <nav class="site-nav" aria-label="Main">
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="visually-hidden">Menu</span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
      </button>

      <div class="nav-menu" id="nav-menu">
        <ul>
          {
            nav.map(({ label, href }) => (
              <li>
                <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="nav-phone" href={site.phoneHref}>
          <Icon name="phone" size={18} />
          {site.phone}
        </a>
        <a class="nav-cta" href="/contact/">Request a quote</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    padding-block: 1.1rem;
    /* Readability scrim over hero imagery */
    background: linear-gradient(to bottom, rgb(4 23 16 / 0.72), transparent);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand img {
    width: clamp(9rem, 12vw, 11.75rem);
    height: auto;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.9rem;
  }

  .nav-menu ul {
    display: flex;
    gap: 1.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-menu ul a {
    color: var(--white);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.05em;
    padding-block: 0.35rem;
    border-block-end: 1px solid transparent;
    transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .nav-menu ul a:hover,
  .nav-menu ul a[aria-current='page'] {
    color: var(--ice);
    border-block-end-color: var(--ice);
  }

  .nav-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--white);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
  }

  .nav-phone:hover {
    color: var(--ice);
  }

  .nav-cta {
    padding: 0.7rem 1.3rem;
    background: var(--ice);
    color: var(--evergreen);
    border-radius: var(--radius);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color 0.2s var(--ease-out);
  }

  .nav-cta:hover {
    background: var(--white);
    color: var(--evergreen);
  }

  .nav-toggle {
    display: none;
  }

  @media (max-width: 64rem) {
    .nav-toggle {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      background: rgb(4 23 16 / 0.5);
      border: 1px solid rgb(255 255 255 / 0.3);
      border-radius: var(--radius);
      cursor: pointer;
    }

    .nav-toggle-bar,
    .nav-toggle-bar::before,
    .nav-toggle-bar::after {
      display: block;
      width: 1.25rem;
      height: 2px;
      background: var(--white);
      border-radius: 2px;
      transition: transform 0.25s var(--ease-out), opacity 0.25s var(--ease-out);
    }

    .nav-toggle-bar {
      position: relative;
    }

    .nav-toggle-bar::before,
    .nav-toggle-bar::after {
      content: '';
      position: absolute;
      left: 0;
    }

    .nav-toggle-bar::before {
      top: -6px;
    }

    .nav-toggle-bar::after {
      top: 6px;
    }

    .nav-toggle[aria-expanded='true'] .nav-toggle-bar {
      background: transparent;
    }

    .nav-toggle[aria-expanded='true'] .nav-toggle-bar::before {
      transform: translateY(6px) rotate(45deg);
    }

    .nav-toggle[aria-expanded='true'] .nav-toggle-bar::after {
      transform: translateY(-6px) rotate(-45deg);
    }

    .nav-menu {
      display: none;
      position: absolute;
      top: calc(100% + 0.5rem);
      inset-inline: var(--gutter);
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
      padding: 1.25rem;
      background: var(--pine-950);
      border: 1px solid rgb(196 249 255 / 0.15);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-card);
    }

    .nav-menu.is-open {
      display: flex;
    }

    .nav-menu ul {
      flex-direction: column;
      gap: 0.25rem;
    }

    .nav-menu ul a {
      display: block;
      padding: 0.6rem 0.5rem;
      font-size: var(--text-base);
    }

    .nav-phone {
      padding: 0.6rem 0.5rem;
    }

    .nav-cta {
      text-align: center;
      padding-block: 0.9rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('nav-menu');

  const isOpen = () => toggle?.getAttribute('aria-expanded') === 'true';
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('is-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(!isOpen()));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (
      isOpen() &&
      e.target instanceof Node &&
      !menu?.contains(e.target) &&
      !toggle?.contains(e.target)
    ) {
      setOpen(false);
    }
  });
</script>
