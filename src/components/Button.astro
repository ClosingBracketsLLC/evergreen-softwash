---
interface Props {
  href: string;
  variant?: 'solid' | 'ice' | 'ghost';
  class?: string;
}
const { href, variant = 'solid', class: className } = Astro.props;
---

<a href={href} class:list={['button', `button--${variant}`, className]}>
  <slot />
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.9rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius);
    position: relative;
    overflow: hidden;
    transition:
      background-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }

  .button:active {
    transform: translateY(1px);
  }

  /* Water-sheen sweep on hover — the brand's signature micro-interaction */
  .button::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgb(196 249 255 / 0.35) 50%,
      transparent 65%
    );
    transform: translateX(-110%);
  }

  .button:hover::after {
    transition: transform 0.6s var(--ease-out);
    transform: translateX(110%);
  }

  @media (prefers-reduced-motion: reduce) {
    .button::after {
      display: none;
    }
  }

  .button--solid {
    background: var(--evergreen);
    color: var(--white);
    border: 1px solid var(--evergreen);
  }

  .button--solid:hover {
    background: var(--pine-800);
    color: var(--white);
  }

  .button--ice {
    background: var(--ice);
    color: var(--evergreen);
    border: 1px solid var(--ice);
  }

  .button--ice:hover {
    background: var(--white);
    color: var(--evergreen);
  }

  .button--ghost {
    background: transparent;
    color: var(--white);
    border: 1px solid rgb(255 255 255 / 0.45);
  }

  .button--ghost:hover {
    border-color: var(--ice);
    color: var(--ice);
  }
</style>
