---
import type { ServiceFaq } from '@data/services';

interface Props {
  faqs: ServiceFaq[];
  /** Emit FAQPage JSON-LD (use on at most one block per page). */
  withSchema?: boolean;
}
const { faqs, withSchema = false } = Astro.props;

const faqSchema = withSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;
---

<div class="faq-list" data-reveal>
  {
    faqs.map((faq) => (
      <details class="faq-item">
        <summary>
          {faq.question}
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M9 3.5v11M3.5 9h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </summary>
        <p>{faq.answer}</p>
      </details>
    ))
  }
</div>

{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

<style>
  .faq-list {
    display: grid;
    gap: 0.85rem;
    max-width: 52rem;
  }

  .faq-item {
    background: var(--white);
    border: 1px solid var(--seaglass-deep);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  :global(.tone-dark) .faq-item {
    background: var(--pine-900);
    border-color: rgb(196 249 255 / 0.14);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.4rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary svg {
    flex: none;
    color: var(--river);
    transition: transform 0.25s var(--ease-out);
  }

  :global(.tone-dark) .faq-item summary svg {
    color: var(--ice);
  }

  .faq-item[open] summary svg {
    transform: rotate(45deg);
  }

  .faq-item p {
    padding: 0 1.4rem 1.3rem;
    color: var(--ink-soft);
    font-size: var(--text-sm);
    max-width: 65ch;
  }

  :global(.tone-dark) .faq-item p {
    color: color-mix(in srgb, var(--seaglass) 75%, transparent);
  }
</style>
