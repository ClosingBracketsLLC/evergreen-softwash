---
import { site, nav } from '@config';
import { services } from '@data/services';
import logoWhite from '../assets/brand/EGSW_logo_white.svg';

const year = new Date().getFullYear();
---

<footer class="site-footer tone-dark">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src={logoWhite.src} alt="" width="72" height="72" loading="lazy" />
      <p class="footer-tagline">{site.tagline}</p>
      <p class="footer-blurb">
        Soft washing, pressure washing, and concierge detailing for the properties, vehicles,
        aircraft, and vessels that deserve more than a once-over.
      </p>
    </div>

    <nav aria-label="Services">
      <h2 class="footer-heading">Services</h2>
      <ul>
        {
          services.map((s) => (
            <li>
              <a href={`/services/${s.slug}/`}>{s.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Company">
      <h2 class="footer-heading">Company</h2>
      <ul>
        {
          nav.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="footer-heading">Contact</h2>
      <ul class="footer-contact">
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{site.hours}</li>
        <li>
          {site.address.locality}, {site.address.region} — serving greater Puget Sound
        </li>
      </ul>
    </div>
  </div>

  <div class="container footer-legal">
    <p>© {year} {site.legalName}. Licensed &amp; insured.</p>
    <p>
      <a href="/services/">Explore services</a> · <a href="/contact/">Request a quote</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-section) 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.4fr;
    gap: 3rem;
    padding-block-end: 3rem;
    border-block-end: 1px solid rgb(196 249 255 / 0.14);
  }

  .footer-brand img {
    width: 4.5rem;
    margin-block-end: 1rem;
  }

  .footer-tagline {
    font-family: var(--font-display);
    font-size: 1.4rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ice);
  }

  .footer-blurb {
    margin-block-start: 0.75rem;
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--seaglass) 70%, transparent);
    max-width: 34ch;
  }

  /* Real h2s for a sound document outline, styled as quiet column labels */
  .site-footer .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ice);
    margin-block-end: 1.1rem;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .site-footer ul a {
    color: color-mix(in srgb, var(--seaglass) 85%, transparent);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .site-footer ul a:hover {
    color: var(--ice);
    text-decoration: underline;
  }

  .footer-contact {
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--seaglass) 70%, transparent);
  }

  .footer-legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-block-start: 1.75rem;
    font-size: var(--text-xs);
    color: color-mix(in srgb, var(--seaglass) 55%, transparent);
  }

  .footer-legal a {
    color: inherit;
  }

  @media (max-width: 56rem) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 34rem) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
