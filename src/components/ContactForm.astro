---
import { site } from '@config';
import { services } from '@data/services';
import Icon from './Icon.astro';
---

<form class="quote-form" action={site.formEndpoint} method="POST" data-reveal>
  <!-- Web3Forms routing -->
  <input type="hidden" name="access_key" value={site.web3formsKey} />
  <input type="hidden" name="subject" value="New quote request — evergreensoftwash.com" />
  <input type="hidden" name="from_name" value="Evergreen Softwash website" />
  <input type="hidden" name="redirect" value={`${site.domain}/thanks/`} />
  <!-- Honeypot: invisible to people (clipped, no tab stop, hidden from AT) but present in the
       DOM for bots to fill. Any value marks the submission as spam on the Web3Forms side.
       Deliberately NOT display:none — smarter bots skip fields they can see are hidden. -->
  <input
    type="checkbox"
    name="botcheck"
    class="botcheck"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />
  <div class="form-row">
    <div class="form-field">
      <label for="qf-name">Full name</label>
      <input id="qf-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="form-field">
      <label for="qf-phone">Phone</label>
      <input id="qf-phone" name="phone" type="tel" autocomplete="tel" required />
    </div>
  </div>

  <div class="form-row">
    <div class="form-field">
      <label for="qf-email">Email</label>
      <input id="qf-email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="form-field">
      <label for="qf-city">City / marina / airfield</label>
      <input id="qf-city" name="location" type="text" placeholder="e.g. Gig Harbor" required />
    </div>
  </div>

  <fieldset class="form-field">
    <legend>What can we care for?</legend>
    <div class="form-checks">
      {
        services.map((s) => (
          <label class="form-check">
            <input type="checkbox" name="services[]" value={s.name} />
            <span>{s.name}</span>
          </label>
        ))
      }
      <label class="form-check">
        <input type="checkbox" name="services[]" value="Estate Program" />
        <span>Estate Program</span>
      </label>
    </div>
  </fieldset>

  <div class="form-field">
    <label for="qf-details">Tell us about the property or craft</label>
    <textarea
      id="qf-details"
      name="details"
      rows="5"
      placeholder="Square footage, stories, vessel length, aircraft type, current condition — whatever you know."
    ></textarea>
  </div>

  <button class="form-submit" type="submit">Send quote request</button>
  <p class="form-note">
    We reply within one business day. Prefer to talk? Call
    <a href={site.phoneHref}>{site.phone}</a>.
  </p>

  <ul class="form-trust" aria-label="Assurances">
    <li><Icon name="shield" size={16} /> Licensed &amp; insured</li>
    <li><Icon name="droplet" size={16} /> 2-year algae-free promise</li>
    <li><Icon name="file" size={16} /> COI available before work begins</li>
  </ul>
</form>

<style>
  .quote-form {
    display: grid;
    gap: 1.4rem;
    padding: 2.25rem;
    background: var(--white);
    border: 1px solid var(--seaglass-deep);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .botcheck {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
  }

  @media (max-width: 40rem) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-field {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .form-field label,
  .form-field legend {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--evergreen);
  }

  .form-field legend {
    margin-block-end: 0.6rem;
  }

  .form-field input[type='text'],
  .form-field input[type='tel'],
  .form-field input[type='email'],
  .form-field textarea {
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--seaglass-deep);
    border-radius: var(--radius);
    background: var(--mist);
    color: var(--ink);
    transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--river);
    box-shadow: 0 0 0 3px rgb(0 114 157 / 0.15);
  }

  .form-checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .form-check {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--seaglass-deep);
    border-radius: 999px;
    font-size: var(--text-sm);
    cursor: pointer;
    transition: border-color 0.2s var(--ease-out), background-color 0.2s var(--ease-out);
  }

  .form-check:has(input:checked) {
    background: var(--evergreen);
    border-color: var(--evergreen);
    color: var(--white);
  }

  .form-check input {
    accent-color: var(--ice);
  }

  .form-submit {
    justify-self: start;
    padding: 1rem 2.2rem;
    background: var(--evergreen);
    color: var(--white);
    border: none;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s var(--ease-out);
  }

  .form-submit:hover {
    background: var(--pine-800);
  }

  .form-note {
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .form-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 1.1rem 0 0;
    border-block-start: 1px solid var(--seaglass-deep);
  }

  .form-trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* :global — the svg comes from <Icon /> and never gets this component's scope class */
  .form-trust :global(svg) {
    flex: none;
    color: var(--river);
  }
</style>
