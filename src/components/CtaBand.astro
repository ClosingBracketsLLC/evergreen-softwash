---
import { Image } from 'astro:assets';
import { site } from '@config';
import { images } from '@data/images';
import Button from './Button.astro';

interface Props {
  title?: string;
  lede?: string;
  image?: keyof typeof images;
}
const {
  title = 'Ready when your property is',
  lede = 'Tell us about your home, vehicle, aircraft, or vessel. A fixed written quote follows within one business day.',
  image = 'estateDusk',
} = Astro.props;
---

<section class="cta-band" aria-label="Request a quote">
  <Image
    class="cta-bg"
    src={images[image]}
    alt=""
    widths={[960, 1440, 2000]}
    sizes="100vw"
    loading="lazy"
    quality="mid"
  />
  <div class="cta-scrim" aria-hidden="true"></div>
  <div class="container cta-inner" data-reveal>
    <h2>{title}</h2>
    <p class="lede">{lede}</p>
    <div class="cta-actions">
      <Button href="/contact/" variant="ice">Request a quote</Button>
      <Button href={site.phoneHref} variant="ghost">Call {site.phone}</Button>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 32rem;
    padding-block: var(--space-section);
    color: var(--seaglass);
    overflow: hidden;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgb(4 23 16 / 0.92) 20%, rgb(4 23 16 / 0.6) 70%, rgb(4 23 16 / 0.42));
  }

  .cta-inner {
    position: relative;
    z-index: 1;
  }

  .cta-inner h2 {
    color: var(--white);
    max-width: 14ch;
  }

  .cta-inner .lede {
    margin-block: 1.25rem 2.25rem;
    color: color-mix(in srgb, var(--seaglass) 85%, transparent);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
